#!/usr/bin/env python3
"""Convert AWS Secrets Manager secrets into a Bitwarden Secrets Manager import file.

Run it once, import the result, delete the file. Needs only Python 3 (standard library)
and, for the direct mode, the AWS CLI already signed in to the right account.

  Direct from AWS:
      python3 aws_to_bitwarden_sm.py --output bws-import.json

  From a file you exported earlier (a list of {"Name", "SecretString", "Description"},
  or the output of `aws secretsmanager batch-get-secret-value`):
      python3 aws_to_bitwarden_sm.py --input aws-export.json --output bws-import.json

Useful options:
  --by-prefix    one Bitwarden project per first path segment ("prod/db" -> project "prod")
  --env-safe     make keys safe for environment variables ("prod/db-pass" -> PROD_DB_PASS)
  --prefix X     only migrate AWS secrets whose name starts with X
  --profile/--region   passed through to the AWS CLI
"""
import argparse
import json
import os
import re
import subprocess
import sys
import uuid


def aws(args, profile, region):
    cmd = ["aws"] + args + ["--output", "json"]
    if profile:
        cmd += ["--profile", profile]
    if region:
        cmd += ["--region", region]
    result = subprocess.run(cmd, capture_output=True, text=True, check=True)
    return json.loads(result.stdout)


def read_from_aws(profile, region):
    """List every secret, then read each value. The AWS CLI v2 pages through results itself."""
    listing = aws(["secretsmanager", "list-secrets"], profile, region)["SecretList"]
    secrets, failed = [], []
    for item in listing:
        try:
            value = aws(["secretsmanager", "get-secret-value", "--secret-id", item["ARN"]], profile, region)
        except subprocess.CalledProcessError as err:
            failed.append((item["Name"], (err.stderr or "").strip().splitlines()[-1:] or ["unknown error"]))
            continue
        value["Description"] = item.get("Description", "")
        secrets.append(value)
    return secrets, failed


def read_from_file(path):
    with open(path, encoding="utf-8") as handle:
        data = json.load(handle)
    if isinstance(data, dict):
        data = data.get("SecretValues") or data.get("SecretList") or []
    return data, []


def make_key(name, env_safe, used):
    key = re.sub(r"[^A-Za-z0-9_]", "_", name).upper() if env_safe else name
    if env_safe and key[:1].isdigit():
        key = "_" + key
    base, n = key, 2
    while key in used:  # keep keys unique after cleaning
        key, n = f"{base}_{n}", n + 1
    used.add(key)
    return key


def convert(secrets, args):
    projects, out_secrets, skipped, used = {}, [], [], set()

    def project_id(name):
        if name not in projects:
            projects[name] = str(uuid.uuid4())
        return projects[name]

    for item in secrets:
        name = item.get("Name", "")
        if args.prefix and not name.startswith(args.prefix):
            continue
        value = item.get("SecretString")
        if value is None:
            skipped.append((name, "binary secret (Bitwarden secrets are text)"))
            continue
        if value == "":
            skipped.append((name, "empty value"))
            continue
        project = args.project_name
        if args.by_prefix and "/" in name.strip("/"):
            project = name.strip("/").split("/")[0]
        note = f"Migrated from AWS Secrets Manager: {name}"
        if item.get("Description"):
            note += f". {item['Description']}"
        out_secrets.append({
            "id": str(uuid.uuid4()),
            "key": make_key(name, args.env_safe, used),
            "value": value,
            "note": note,
            "projectIds": [project_id(project)],
        })

    return {
        "projects": [{"id": pid, "name": pname} for pname, pid in projects.items()],
        "secrets": out_secrets,
    }, skipped


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--input", help="JSON file exported from AWS (omit to read directly from AWS)")
    p.add_argument("--output", default="bws-import.json")
    p.add_argument("--project-name", default="AWS Migration")
    p.add_argument("--by-prefix", action="store_true")
    p.add_argument("--env-safe", action="store_true")
    p.add_argument("--prefix")
    p.add_argument("--profile")
    p.add_argument("--region")
    args = p.parse_args()

    try:
        secrets, failed = read_from_file(args.input) if args.input else read_from_aws(args.profile, args.region)
    except FileNotFoundError:
        sys.exit("Could not find the AWS CLI. Install it and sign in, or use --input with an exported file.")
    except subprocess.CalledProcessError as err:
        sys.exit(f"AWS CLI error: {(err.stderr or '').strip()}")

    result, skipped = convert(secrets, args)

    fd = os.open(args.output, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        json.dump(result, handle, indent=2)

    print(f"Wrote {len(result['secrets'])} secrets in {len(result['projects'])} project(s) to {args.output}")
    for name, reason in skipped:
        print(f"  skipped {name}: {reason}")
    for name, reason in failed:
        print(f"  could not read {name}: {reason[0]}")
    print("This file contains plaintext secrets. Import it, then delete it.")


if __name__ == "__main__":
    main()
